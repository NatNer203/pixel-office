{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "pixel-office",
    "version":  "0.4.2",
    "identifier":  "com.pixeloffice.app",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "pixel-office",
                                    "width":  1200,
                                    "height":  250,
                                    "decorations":  false,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "backgroundColor":  "#20242B"
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "createUpdaterArtifacts":  true,
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "languages":  [
                                                                  "French",
                                                                  "English"
                                                              ]
                                            }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2MjBDN0Q3RkIwMDU3ODkKUldTSlZ3RDcxOGNnTnUycEJnd1dYTjVYS2c3QzFmbXlEWGkzc0tQTnlQSktLdkhsSXFLRXNOUTAK",
                                    "dangerousInsecureTransportProtocol":  true,
                                    "endpoints":  [

                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}